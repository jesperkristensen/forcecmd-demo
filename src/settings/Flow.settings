<?xml version="1.0" encoding="UTF-8"?>
<FlowSettings xmlns="http://soap.sforce.com/2006/04/metadata">
    <canDebugFlowAsAnotherUser>false</canDebugFlowAsAnotherUser>
    <doesEnforceApexCpuTimeLimit>true</doesEnforceApexCpuTimeLimit>
    <doesFormulaEnforceDataAccess>true</doesFormulaEnforceDataAccess>
    <doesFormulaGenerateHtmlOutput>false</doesFormulaGenerateHtmlOutput>
    <enableEmailSimpleRespectProfiles>false</enableEmailSimpleRespectProfiles>
    <enableEmailsimpleSecureProfiles>false</enableEmailsimpleSecureProfiles>
    <enableFlowBREncodedFixEnabled>true</enableFlowBREncodedFixEnabled>
    <enableFlowCustomPropertyEditor>false</enableFlowCustomPropertyEditor>
    <enableFlowDeployAsActiveEnabled>false</enableFlowDeployAsActiveEnabled>
    <enableFlowFieldFilterEnabled>true</enableFlowFieldFilterEnabled>
    <enableFlowFormulasFixEnabled>true</enableFlowFormulasFixEnabled>
    <enableFlowInterviewSharingEnabled>true</enableFlowInterviewSharingEnabled>
    <enableFlowListMetadataLargeCapEnabled>false</enableFlowListMetadataLargeCapEnabled>
    <enableFlowNullPreviousValueFix>false</enableFlowNullPreviousValueFix>
    <enableFlowPauseEnabled>false</enableFlowPauseEnabled>
    <enableFlowReactiveChoiceOptions>false</enableFlowReactiveChoiceOptions>
    <enableFlowReactiveScreens>false</enableFlowReactiveScreens>
    <enableFlowUseApexExceptionEmail>false</enableFlowUseApexExceptionEmail>
    <enableFlowViaRestUsesUserCtxt>true</enableFlowViaRestUsesUserCtxt>
    <enableFlowsLightningApp>true</enableFlowsLightningApp>
    <enableLightningRuntimeEnabled>false</enableLightningRuntimeEnabled>
    <flowOccurrenceLogging>false</flowOccurrenceLogging>
    <isApexPluginAccessModifierRespected>true</isApexPluginAccessModifierRespected>
    <isEnhancedFlowListViewVisible>true</isEnhancedFlowListViewVisible>
    <isFlowBlockAccessToSessionIDEnabled>true</isFlowBlockAccessToSessionIDEnabled>
    <isManageFlowRequiredForAutomationCharts>false</isManageFlowRequiredForAutomationCharts>
</FlowSettings>
